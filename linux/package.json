{
  "name": "smart-cat-feeder-linux",
  "version": "0.1.0",
  "private": true,
  "description": "Linux device service and Khadas simulator for Smart Cat Feeder",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/**/*.test.ts",
    "test:gateway": "tsx --test tests/backend-http/http-backend-gateway.contract.test.ts tests/runtime/bootstrap.test.ts",
    "test:runtime": "tsx --test tests/config/runtime-config.test.ts tests/observability/json-logger.test.ts tests/runtime/bootstrap.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
