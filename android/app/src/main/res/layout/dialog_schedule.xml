<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_editor_time"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TimePicker
            android:id="@+id/schedule_editor_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/schedule_editor_days"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/schedule_day_mon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_mon_short" />

            <CheckBox
                android:id="@+id/schedule_day_tue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_tue_short" />

            <CheckBox
                android:id="@+id/schedule_day_wed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_wed_short" />

            <CheckBox
                android:id="@+id/schedule_day_thu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_thu_short" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/schedule_day_fri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_fri_short" />

            <CheckBox
                android:id="@+id/schedule_day_sat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_sat_short" />

            <CheckBox
                android:id="@+id/schedule_day_sun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day_sun_short" />
        </LinearLayout>

        <TextView
            android:id="@+id/schedule_timezone_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/schedule_timezone_input"
            android:text="@string/schedule_editor_timezone"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/schedule_timezone_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/schedule_editor_timezone_hint"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <TextView
            android:id="@+id/schedule_portion_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/schedule_portion_input"
            android:text="@string/schedule_editor_portion"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/schedule_portion_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/schedule_editor_portion_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/schedule_active_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/schedule_editor_active" />

        <TextView
            android:id="@+id/schedule_editor_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/error"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</ScrollView>
