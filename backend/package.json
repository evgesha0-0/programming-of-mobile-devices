{
  "name": "smart-cat-feeder-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for Smart Cat Feeder",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
