NODE_ENV=development
LOG_LEVEL=info
HARDWARE_ADAPTER=simulator
BACKEND_URL=https://backend.example.test
DEVICE_ID=00000000-0000-4000-8000-000000000000
DEVICE_TOKEN_FILE=./secrets/device-token
SQLITE_PATH=./data/device.sqlite
HEARTBEAT_INTERVAL_MS=30000
SCHEDULE_SYNC_INTERVAL_MS=60000
COMMAND_POLL_INTERVAL_MS=5000
REQUEST_TIMEOUT_MS=10000
BACKOFF_INITIAL_MS=1000
BACKOFF_MAX_MS=60000
MAX_CLOCK_SKEW_MS=30000
FEEDING_TIMEOUT_MS=30000
SCHEDULER_TICK_MS=1000
SCHEDULE_MAX_LATENESS_MS=300000
SIMULATOR_SEED=smart-cat-feeder
SIMULATOR_SCENARIO=normal
SIMULATOR_SOCKET_PATH=/tmp/smart-cat-feeder-simulator.sock
SIMULATOR_AUTO_ADVANCE=true
